# -- NVIDIA Nemotron (required for the AI layer) -------------------------
# Get a key at https://build.nvidia.com/ -> API Keys
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# -- Generation parameters ----------------------------------------------
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.95

# -- Transport / reliability --------------------------------------------
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=2.0

# -- Observability -------------------------------------------------------
# Prompts can contain source code; logging them is OFF by default.
LLM_LOG_PROMPTS=false

# -- Local embeddings (never sent to a remote API) -----------------------
ACG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
ACG_EMBED_DIM=384
ACG_EMBED_DEVICE=cpu
