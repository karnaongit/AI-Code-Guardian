# -- NVIDIA Nemotron 3 Ultra (required for the AI layer) ------------------
# Get a key at https://build.nvidia.com/ -> API Keys
NVIDIA_API_KEY="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"
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# -- Generation parameters ----------------------------------------------
LLM_TEMPERATURE=1.0
LLM_MAX_TOKENS=16384
LLM_TOP_P=0.95

# -- Transport / reliability --------------------------------------------
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=2.0

# -- Observability -------------------------------------------------------
# Prompts can contain source code; logging them is OFF by default.
LLM_LOG_PROMPTS=false

# -- Nemotron Ultra reasoning (chain-of-thought) -------------------------
LLM_ENABLE_THINKING=true
LLM_REASONING_BUDGET=16384

# -- Local embeddings (never sent to a remote API) -----------------------
ACG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
ACG_EMBED_DIM=384
ACG_EMBED_DEVICE=cpu

# -- Local Backing Services ----------------------------------------------
DATABASE_URL=postgresql+asyncpg://guardian:guardian_pass@localhost:5432/guardian_db
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Set to a local folder path (e.g., ./qdrant_data) to use embedded file-backed mode, 
# or use :memory: for in-memory, or an http URL for a remote server.
QDRANT_LOCATION=./qdrant_data
